#
# This is a project Makefile. It is assumed the directory this Makefile resides in is a
# project subdirectory.
#

PROJECT_NAME := sensor

# The rules below are defined before the SDK makefiles are included, so pin
# the default goal to 'all' (the first target would otherwise be
# git_version.h and make would build nothing else).
.DEFAULT_GOAL := all

#
# Build-time version info for tracking, printed to the serial log at
# startup by print_build_info() in main.c, and reported by the FW_VERSION
# command (the firmware version is the git hash):
#   - git branch and short sha of this repo at build time
#   - "-dirty" marker when the working tree has uncommitted changes
#
# The values are generated into build/include/git_version.h (build/include
# is on the include path) and included by main.c. The file is only
# rewritten when its content changes, so its timestamp - and thus the
# rebuild of the objects that include it - changes exactly when the git
# state (branch/sha/dirty) changes. This keeps the embedded build info up
# to date with incremental builds, which plain -D flags cannot do.
# The macros are empty strings when git is not available at build time.
#
GIT_BRANCH := $(shell git rev-parse --abbrev-ref HEAD 2>/dev/null)
GIT_SHA    := $(shell git rev-parse --short HEAD 2>/dev/null)
GIT_STATUS := $(shell git status --porcelain 2>/dev/null)
ifneq ($(GIT_STATUS),)
GIT_DIRTY  := -dirty
else
GIT_DIRTY  :=
endif

GIT_VERSION_H := build/include/git_version.h

$(GIT_VERSION_H): FORCE
	@{ \
	  echo "/* Auto-generated by the project Makefile, do not edit. */"; \
	  echo "#define APP_GIT_BRANCH \"$(GIT_BRANCH)\""; \
	  echo "#define APP_GIT_SHA \"$(GIT_SHA)\""; \
	  echo "#define APP_GIT_DIRTY \"$(GIT_DIRTY)\""; \
	} > $@.new
	@cmp -s $@.new $@ 2>/dev/null || mv $@.new $@
	@rm -f $@.new

.PHONY: FORCE
FORCE:

# Generate the version header before the main component is built
component-main-build: $(GIT_VERSION_H)

include $(IDF_PATH)/make/project.mk
